  { type: 'codigo', original: 'AL/16', formatted: 'AL/16', code: 'AL/16', letter: 'A' },
  { type: 'codigo', original: 'SE/20', formatted: 'SE/20', code: 'SE/20', letter: 'S' },
  { type: 'codigo', original: 'LA/13', formatted: 'LA/13', code: 'LA/13', letter: 'L' },
  { type: 'codigo', original: 'AL/23', formatted: 'AL/23', code: 'AL/23', letter: 'A' },
  { type: 'codigo', original: 'LA/16', formatted: 'LA/16', code: 'LA/16', letter: 'L' },
];

const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

export default function App() {
  const [user, setUser] = useState(null);
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  
  // Filtros y Búsqueda
  const [selectedLetter, setSelectedLetter] = useState('ALL');
  const [selectedType, setSelectedType] = useState('ALL');
  const [searchQuery, setSearchQuery] = useState('');

  // Modales y Formularios
  const [isAddModalOpen, setIsAddModalOpen] = useState(false);
  const [editingItem, setEditingItem] = useState(null);
  const [newItem, setNewItem] = useState({
    formatted: '',
    original: '',
    code: '',
    type: 'persona'
  });

  // Autenticación de Firebase
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error("Error al autenticar:", err);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, setUser);
    return () => unsubscribe();
  }, []);

  // Carga y sincronización de datos con Firestore
  useEffect(() => {
    if (!user) return;

    const archiveCollection = collection(db, 'artifacts', appId, 'public', 'data', 'secretarial_records');
    
    const unsubscribe = onSnapshot(
      archiveCollection,
      (snapshot) => {
        if (snapshot.empty) {
          // Si la colección está vacía, poblar con datos iniciales
          initialData.forEach((item) => {
            addDoc(archiveCollection, {
              ...item,
              createdAt: serverTimestamp()
            });
          });
        } else {
          const loadedItems = snapshot.docs.map(doc => ({
            id: doc.id,
            ...doc.data()
          }));
          setItems(loadedItems);
        }
        setLoading(false);
      },
      (error) => {
        console.error("Error al escuchar cambios:", error);
        setLoading(false);
      }
    );

    return () => unsubscribe();
  }, [user]);

  // Función para determinar la letra alfabética
  const getFirstLetter = (str) => {
    if (!str) return 'A';
    const cleanStr = str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim().toUpperCase();
    const firstChar = cleanStr.charAt(0);
    return ALPHABET.includes(firstChar) ? firstChar : '#';
  };

  // Agregar nuevo ítem
  const handleAddItem = async (e) => {
    e.preventDefault();
    if (!newItem.formatted.trim()) return;

    const letter = getFirstLetter(newItem.formatted);
    try {
      const archiveCollection = collection(db, 'artifacts', appId, 'public', 'data', 'secretarial_records');
      await addDoc(archiveCollection, {
        ...newItem,
        letter,
        createdAt: serverTimestamp()
      });
      setNewItem({ formatted: '', original: '', code: '', type: 'persona' });
      setIsAddModalOpen(false);
    } catch (err) {
      console.error("Error al agregar registro:", err);
    }
  };

  // Actualizar un ítem
  const handleUpdateItem = async (e) => {
    e.preventDefault();
    if (!editingItem || !editingItem.formatted.trim()) return;

    const letter = getFirstLetter(editingItem.formatted);
    try {
      const itemDoc = doc(db, 'artifacts', appId, 'public', 'data', 'secretarial_records', editingItem.id);
      await updateDoc(itemDoc, {
        formatted: editingItem.formatted,
        original: editingItem.original,
        code: editingItem.code,
        type: editingItem.type,
        letter
      });
      setEditingItem(null);
    } catch (err) {
      console.error("Error al actualizar registro:", err);
    }
  };

  // Eliminar un ítem
  const handleDeleteItem = async (id) => {
    try {
      const itemDoc = doc(db, 'artifacts', appId, 'public', 'data', 'secretarial_records', id);
      await deleteDoc(itemDoc);
    } catch (err) {
      console.error("Error al borrar registro:", err);
    }
  };

  // Función de ordenación natural alfabética / alfanumérica
  const sortItems = (itemList) => {
    return [...itemList].sort((a, b) => {
      // Si son códigos alfanuméricos como AL/22 y AL/26
      if (a.type === 'codigo' && b.type === 'codigo') {
        return a.formatted.localeCompare(b.formatted, undefined, { numeric: true, sensitivity: 'base' });
      }
      return a.formatted.localeCompare(b.formatted, 'es', { sensitivity: 'base' });
    });
  };

  // Filtrar ítems
  const filteredItems = useMemo(() => {
    let result = items;

    // Filtro por tipo
    if (selectedType !== 'ALL') {
      result = result.filter(item => item.type === selectedType);
    }

    // Filtro por letra
    if (selectedLetter !== 'ALL') {
      result = result.filter(item => item.letter === selectedLetter);
    }

    // Filtro por búsqueda
    if (searchQuery.trim() !== '') {
      const query = searchQuery.toLowerCase();
      result = result.filter(item => 
        (item.formatted && item.formatted.toLowerCase().includes(query)) ||
        (item.original && item.original.toLowerCase().includes(query)) ||
        (item.code && item.code.toLowerCase().includes(query))
      );
    }

    return sortItems(result);
  }, [items, selectedType, selectedLetter, searchQuery]);

  // Contadores por Letra
  const letterCounts = useMemo(() => {
    const counts = {};
    ALPHABET.forEach(l => counts[l] = 0);
    items.forEach(item => {
      if (item.letter && counts[item.letter] !== undefined) {
        counts[item.letter]++;
      }
    });
    return counts;
  }, [items]);

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 flex flex-col font-sans">
      {/* Encabezado Principal */}
      <header className="bg-indigo-900 text-white shadow-lg border-b border-indigo-800">
        <div className="max-w-7xl mx-auto px-4 py-6 sm:px-6 lg:px-8">
          <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div className="flex items-center space-x-3">
              <div className="p-3 bg-indigo-700/60 rounded-xl border border-indigo-500/30">
                <BookOpen className="h-8 w-8 text-amber-400" />
              </div>
              <div>
                <h1 className="text-2xl font-bold tracking-tight text-white sm:text-3xl">
                  Fundamentos Básicos Secretariales
                </h1>
                <p className="text-indigo-200 text-sm mt-1">
                  Sistema de Organización, Clasificación e Indización de Archivos
                </p>
              </div>
            </div>

            <button
              onClick={() => setIsAddModalOpen(true)}
              className="inline-flex items-center justify-center px-4 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-900 font-semibold shadow-md transition-all active:scale-95 cursor-pointer"
            >
              <Plus className="w-5 h-5 mr-1.5 stroke-[2.5]" />
              Nuevo Registro
            </button>
          </div>
        </div>
      </header>

      {/* Contenido Principal */}
      <main className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
        
        {/* Barra de Búsqueda y Filtros de Categoría */}
        <div className="bg-white rounded-2xl p-4 sm:p-6 shadow-sm border border-slate-200 space-y-4">
          <div className="flex flex-col md:flex-row gap-4">
            
            {/* Buscador Input */}
            <div className="relative flex-1">
              <div className="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <Search className="h-5 w-5" />
              </div>
              <input
                type="text"
                placeholder="Buscar por nombre, apellidos, empresa o código alfanumérico..."
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                className="block w-full pl-10 pr-10 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all text-sm"
              />
              {searchQuery && (
                <button
                  onClick={() => setSearchQuery('')}
                  className="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600"
                >
                  <X className="h-5 w-5" />
                </button>
              )}
            </div>

            {/* Menú Desplegable de Tipo */}
            <div className="flex items-center gap-2">
              <select
                value={selectedType}
                onChange={(e) => setSelectedType(e.target.value)}
                className="w-full md:w-auto px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-slate-700 font-medium text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white cursor-pointer"
              >
                <option value="ALL">📂 Todas las Secciones</option>
                <option value="persona">👤 1. Personas (Reglas de Archivo)</option>
                <option value="empresa">🏢 2. Nombre de Empresas</option>
                <option value="codigo">🔢 3. Códigos Alfanuméricos</option>
              </select>
            </div>
          </div>

          {/* Selector A-Z (Navegador de Carpetas Alfabéticas) */}
          <div className="pt-2">
            <div className="flex items-center justify-between mb-2">
              <span className="text-xs font-bold uppercase tracking-wider text-slate-500 flex items-center gap-1">
                <Folder className="w-4 h-4 text-indigo-600" /> Carpetas Alfabéticas (A-Z)
              </span>
              {selectedLetter !== 'ALL' && (
                <button
                  onClick={() => setSelectedLetter('ALL')}
                  className="text-xs text-indigo-600 hover:text-indigo-800 font-semibold underline cursor-pointer"
                >
                  Mostrar todas las carpetas
                </button>
              )}
            </div>

            <div className="flex flex-wrap gap-1.5">
              <button
                onClick={() => setSelectedLetter('ALL')}
                className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer ${
                  selectedLetter === 'ALL'
                    ? 'bg-indigo-600 text-white shadow'
                    : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
              >
                TODAS ({items.length})
              </button>
              {ALPHABET.map((letter) => {
                const count = letterCounts[letter] || 0;
                return (
                  <button
                    key={letter}
                    onClick={() => setSelectedLetter(letter)}
                    className={`px-2.5 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1 transition-all cursor-pointer ${
                      selectedLetter === letter
                        ? 'bg-indigo-600 text-white shadow'
                        : count > 0
                        ? 'bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200'
                        : 'bg-slate-100 text-slate-400 hover:bg-slate-200'
                    }`}
                  >
                    <span>{letter}</span>
                    {count > 0 && (
                      <span className={`text-[10px] px-1 rounded-full ${
                        selectedLetter === letter ? 'bg-indigo-800 text-white' : 'bg-indigo-200 text-indigo-800'
                      }`}>
                        {count}
                      </span>
                    )}
                  </button>
                );
              })}
            </div>
          </div>
        </div>

        {/* Guía informativa de reglas secretariales */}
        <div className="bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-start gap-3 text-amber-800 text-xs sm:text-sm">
          <Info className="w-5 h-5 text-amber-600 shrink-0 mt-0.5" />
          <div>
            <p className="font-semibold text-amber-900">Reglas de Organización Aplicadas:</p>
            <p className="mt-0.5">
              <strong>Personas:</strong> Inversión de nombre (<em>Primer Apellido, Segundo Apellido, Nombre</em>).<br/>
              <strong>Empresas:</strong> Ordenadas por su nombre oficial registrado.<br/>
              <strong>Códigos Alfanuméricos:</strong> Ordenados primero por letras y luego numéricamente ascendente.
            </p>
          </div>
        </div>

        {/* Lista de Registros / Carpetas */}
        {loading ? (
          <div className="flex flex-col items-center justify-center py-16 text-slate-500">
            <RefreshCw className="w-8 h-8 animate-spin text-indigo-600 mb-2" />
            <p className="text-sm font-medium">Cargando base de datos colaborativa...</p>
          </div>
        ) : filteredItems.length === 0 ? (
          <div className="bg-white rounded-2xl p-12 text-center border border-slate-200">
            <Folder className="w-12 h-12 text-slate-300 mx-auto mb-3" />
            <h3 className="text-lg font-bold text-slate-700">No se encontraron carpetas o archivos</h3>
            <p className="text-slate-500 text-sm mt-1">
              Prueba cambiando la búsqueda, seleccionando otra letra o creando un nuevo registro.
            </p>
          </div>
        ) : (
          <div className="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <div className="px-6 py-4 border-b border-slate-200 bg-slate-50/80 flex items-center justify-between">
              <span className="text-xs font-bold text-slate-500 uppercase tracking-wider">
                Mostrando {filteredItems.length} registro(s)
              </span>
              <span className="text-xs text-slate-400">
                ✏️ Edición pública y colaborativa activada
              </span>
            </div>

            <div className="divide-y divide-slate-100">
              {filteredItems.map((item, index) => (
                <div 
                  key={item.id || index} 
                  className="p-4 sm:p-5 hover:bg-indigo-50/40 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4 group"
                >
                  <div className="flex items-start gap-3.5">
                    {/* Badge de tipo de archivo */}
                    <div className={`p-2.5 rounded-xl shrink-0 mt-0.5 ${
                      item.type === 'persona' 
                        ? 'bg-blue-100 text-blue-700' 
                        : item.type === 'empresa' 
                        ? 'bg-emerald-100 text-emerald-700' 
                        : 'bg-purple-100 text-purple-700'
                    }`}>
                      {item.type === 'persona' && <User className="w-5 h-5" />}
                      {item.type === 'empresa' && <Building2 className="w-5 h-5" />}
                      {item.type === 'codigo' && <Hash className="w-5 h-5" />}
                    </div>

                    <div className="space-y-1">
                      <div className="flex flex-wrap items-center gap-2">
                        <span className="font-bold text-slate-900 text-base sm:text-lg">
                          {item.formatted}
                        </span>
                        {item.code && (
                          <span className="px-2 py-0.5 text-xs font-mono font-semibold bg-slate-100 text-slate-700 rounded border border-slate-200">
                            {item.code}
                          </span>
                        )}
                        <span className="px-2 py-0.5 text-[10px] font-bold uppercase rounded-full bg-indigo-100 text-indigo-700">
                          Carpeta {item.letter}
                        </span>
                      </div>

                      {item.original && item.type === 'persona' && item.original !== item.formatted && (
                        <p className="text-xs text-slate-500 flex items-center gap-1">
                          <FileText className="w-3.5 h-3.5 text-slate-400" />
                          Nombre original: <span className="italic">{item.original}</span>
                        </p>
                      )}

                      <div className="text-[11px] text-slate-400">
                        Clasificación: {
                          item.type === 'persona' ? '1. Nombres de Personas' :
                          item.type === 'empresa' ? '2. Nombres de Empresas' : '3. Códigos Alfanuméricos'
                        }
                      </div>
                    </div>
                  </div>

                  {/* Acciones para editar o borrar */}
                  <div className="flex items-center gap-2 self-end sm:self-center opacity-90 sm:opacity-0 group-hover:opacity-100 transition-opacity">
                    <button
                      onClick={() => setEditingItem(item)}
                      className="p-2 text-indigo-600 hover:bg-indigo-100 rounded-lg transition-colors cursor-pointer"
                      title="Editar registro"
                    >
                      <Edit2 className="w-4 h-4" />
                    </button>
                    <button
                      onClick={() => handleDeleteItem(item.id)}
                      className="p-2 text-rose-600 hover:bg-rose-100 rounded-lg transition-colors cursor-pointer"
                      title="Eliminar registro"
                    >
                      <Trash2 className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </main>

      {/* Modal para Agregar Nuevo Registro */}
      {isAddModalOpen && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 space-y-4">
            <div className="flex items-center justify-between border-b border-slate-100 pb-3">
              <h3 className="text-lg font-bold text-slate-900 flex items-center gap-2">
                <Plus className="w-5 h-5 text-indigo-600" /> Nuevo Archivo / Registro
              </h3>
              <button 
                onClick={() => setIsAddModalOpen(false)}
                className="text-slate-400 hover:text-slate-600 p-1 rounded-lg"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleAddItem} className="space-y-4">
              <div>
                <label className="block text-xs font-bold uppercase text-slate-600 mb-1">
                  Sección / Categoría
                </label>
                <select
                  value={newItem.type}
                  onChange={(e) => setNewItem({ ...newItem, type: e.target.value })}
                  className="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white"
                >
                  <option value="persona">Persona (Inversión por Apellidos)</option>
                  <option value="empresa">Empresa / Firma Comercial</option>
                  <option value="codigo">Código Alfanumérico</option>
                </select>
              </div>

              <div>
                <label className="block text-xs font-bold uppercase text-slate-600 mb-1">
                  Nombre Clasificado (Para Orden Alfabético)
                </label>
                <input
                  type="text"
                  required
                  placeholder={
                    newItem.type === 'persona' 
                      ? 'Ej: Serrano Martínez, Laura' 
                      : newItem.type === 'empresa' 
                      ? 'Ej: Super Mercado Óle' 
                      : 'Ej: SE/25'
                  }
                  value={newItem.formatted}
                  onChange={(e) => setNewItem({ ...newItem, formatted: e.target.value })}
                  className="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white"
                />
              </div>

              {newItem.type === 'persona' && (
                <div>
                  <label className="block text-xs font-bold uppercase text-slate-600 mb-1">
                    Nombre Original (Opcional)
                  </label>
                  <input
                    type="text"
                    placeholder="Ej: Laura Serrano Martínez"
                    value={newItem.original}
                    onChange={(e) => setNewItem({ ...newItem, original: e.target.value })}
                    className="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white"
                  />
                </div>
              )}

              <div>
                <label className="block text-xs font-bold uppercase text-slate-600 mb-1">
                  Código Asignado (Opcional)
                </label>
                <input
                  type="text"
                  placeholder="Ej: PERS-021 o SE/25"
                  value={newItem.code}
                  onChange={(e) => setNewItem({ ...newItem, code: e.target.value })}
                  className="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white"
                />
              </div>

              <div className="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => setIsAddModalOpen(false)}
                  className="px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 rounded-lg cursor-pointer"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  className="px-5 py-2 text-sm font-semibold text-slate-900 bg-amber-400 hover:bg-amber-500 rounded-lg shadow cursor-pointer"
                >
                  Guardar en Archivo
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal para Editar Registro */}
      {editingItem && (
        <div className="fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
          <div className="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 space-y-4">
            <div className="flex items-center justify-between border-b border-slate-100 pb-3">
              <h3 className="text-lg font-bold text-slate-900 flex items-center gap-2">
                <Edit2 className="w-5 h-5 text-indigo-600" /> Editar Registro
              </h3>
              <button 
                onClick={() => setEditingItem(null)}
                className="text-slate-400 hover:text-slate-600 p-1 rounded-lg"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <form onSubmit={handleUpdateItem} className="space-y-4">
              <div>
                <label className="block text-xs font-bold uppercase text-slate-600 mb-1">
                  Sección / Categoría
                </label>
                <select
                  value={editingItem.type}
                  onChange={(e) => setEditingItem({ ...editingItem, type: e.target.value })}
                  className="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white"
                >
                  <option value="persona">Persona</option>
                  <option value="empresa">Empresa</option>
                  <option value="codigo">Código Alfanumérico</option>
                </select>
              </div>

              <div>
                <label className="block text-xs font-bold uppercase text-slate-600 mb-1">
                  Nombre Clasificado
                </label>
                <input
                  type="text"
                  required
                  value={editingItem.formatted}
                  onChange={(e) => setEditingItem({ ...editingItem, formatted: e.target.value })}
                  className="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white"
                />
              </div>

              {editingItem.type === 'persona' && (
                <div>
                  <label className="block text-xs font-bold uppercase text-slate-600 mb-1">
                    Nombre Original
                  </label>
                  <input
                    type="text"
                    value={editingItem.original || ''}
                    onChange={(e) => setEditingItem({ ...editingItem, original: e.target.value })}
                    className="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white"
                  />
                </div>
              )}

              <div>
                <label className="block text-xs font-bold uppercase text-slate-600 mb-1">
                  Código
                </label>
                <input
                  type="text"
                  value={editingItem.code || ''}
                  onChange={(e) => setEditingItem({ ...editingItem, code: e.target.value })}
                  className="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-slate-800 text-sm focus:ring-2 focus:ring-indigo-500 focus:bg-white"
                />
              </div>

              <div className="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => setEditingItem(null)}
                  className="px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 rounded-lg cursor-pointer"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  className="px-5 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow cursor-pointer flex items-center gap-1.5"
                >
                  <Save className="w-4 h-4" /> Actualizar
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Pie de Página */}
      <footer className="bg-slate-900 text-slate-400 text-xs py-6 mt-12 border-t border-slate-800">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-1">
          <p className="text-slate-300 font-medium">Práctica Profesional de Organización y Archivo Secretarial</p>
          <p className="text-slate-500">Cualquier usuario con el enlace puede agregar, editar o eliminar carpetas y códigos en tiempo real.</p>
        </div>
      </footer>
    </div>
  );
}
